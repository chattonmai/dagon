{
  "name": "dagon",
  "displayName": "Dagon",
  "description": "Navigate from task to node implementation in Go DAG projects",
  "version": "0.0.2",
  "publisher": "chattonmai",
  "repository": {
    "type": "git",
    "url": "https://github.com/private/go-node-navigator"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:go"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dagon.navigateToNode",
        "title": "Go to Node Implementation"
      },
      {
        "command": "dagon.findUsages",
        "title": "Find Node Usages"
      },
      {
        "command": "dagon.findUsagesFor",
        "title": "Find Node Usages For Key"
      },
      {
        "command": "dagon.reorderByTask",
        "title": "Dagon: Reorganize nodes by task"
      },
      {
        "command": "dagon.createNewDag",
        "title": "Dagon: Create New DAG"
      },
      {
        "command": "dagon.createDagFrom",
        "title": "Dagon: Create New DAG From Existing"
      },
      {
        "command": "dagon.searchDag",
        "title": "Dagon: Search DAG"
      }
    ],
    "keybindings": [
      {
        "command": "dagon.navigateToNode",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus && editorLangId == go"
      },
      {
        "command": "dagon.findUsages",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorTextFocus && editorLangId == go"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "typescript-eslint": "^8.0.0",
    "eslint": "^9.0.0",
    "esbuild": "^0.19.11",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.3",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8"
  }
}